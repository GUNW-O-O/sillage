# 로컬 개발 (docker-compose.yml)
# 로컬은 pooler 가 없으므로 두 값이 같다.
# 원격(Supabase) 전환 시 DATABASE_URL 만 Supavisor :6543 + ?pgbouncer=true 로 바꾼다.
DATABASE_URL="postgresql://sillage:sillage_local@localhost:5432/sillage?schema=public"
DIRECT_URL="postgresql://sillage:sillage_local@localhost:5432/sillage?schema=public"

# 내부망(폰)에서 dev 서버에 붙을 때 허용할 origin. 쉼표 구분.
# Next 가 다른 origin 의 /_next/* 요청을 막으므로 접속 기기 주소를 넣는다.
# DEV_ORIGINS="183.102.12.34"

AUTH_SECRET=32자 이상의 임의 문자열
