// 실라주 v0.1 스키마
// 설계 4장 · 요구명세 FR-1~9 대응.
// 원칙: 스키마는 v1 형태 그대로 둔다. v0.1 에 값이 없어도 컬럼은 지금 넣는다.

generator client {
  provider = "prisma-client-js"
}

// 연결 문자열은 prisma.config.ts 에 있다 (Prisma 7 부터 schema 에서 제거됨).
// 런타임 연결은 @prisma/adapter-pg 어댑터가 DATABASE_URL 로 맺는다.
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────── 계정 (4-9)

enum Role {
  USER
  ADMIN
}

model User {
  id          String   @id @default(cuid())
  displayName String
  role        Role     @default(USER)
  /// v1 에서 Google OAuth 를 붙일 자리. 지금 넣는 비용이 0 이다 (4-9)
  provider       String?
  providerUserId String?
  createdAt      DateTime @default(now())

  invitedByCode   InviteCode?   @relation("InviteRedemption")
  issuedCodes     InviteCode[]  @relation("InviteIssuer")
  experiences     Experience[]
  createdVendors  Vendor[]
  createdProducts Product[]
  createdAliases  NoteAlias[]
  createdLookups  LookupValue[]
  noteProposals   SellerNoteProposal[]

  @@unique([provider, providerUserId])
}

model InviteCode {
  id String @id @default(cuid())
  /// 6자리 숫자. **평문으로 저장한다** (설계 5-2). 어드민 목록에서 발급한 코드를 다시
  /// 볼 수 있어야 직접 건네는 방식이 성립한다. 해시로 두면 발급 직후 1회 표시가 전부다.
  /// 대가는 DB 를 읽을 수 있는 경로에서 미소진 코드를 24시간 안에 쓸 수 있다는 것 —
  /// 폭발 반경이 계정 하나라 받아들였다. 진짜 방어는 만료와 시도 제한이다
  code String @unique
  /// 누구에게 주는 코드인지. 교환 성공 시 User.displayName 이 된다 (설계 5-3).
  /// 소진 전에도 어드민 목록에서 "누구 코드인지" 가 보인다
  label        String
  createdById  String
  usedByUserId String? @unique
  /// 언제 소진됐는지. **`usedByUserId` 와 항상 같이 채워진다** — 어드민 목록이 소진을
  /// 「누가 · 언제」로 보여주는데(설계 5-4) 「언제」를 담을 자리가 없었다.
  /// 채우는 유일한 자리가 교환 화면이라 그것이 생기는 이번에 같이 넣는다 (설계 10-5)
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())

  createdBy User  @relation("InviteIssuer", fields: [createdById], references: [id])
  usedBy    User? @relation("InviteRedemption", fields: [usedByUserId], references: [id])

  @@index([expiresAt])
}

/// 초대 코드 교환 실패 한 건. **행 하나가 곧 실패 로그다** — FR-10 의
/// 「시도 제한 + 실패 로그」가 이 한 테이블로 해결된다 (설계 10-4).
///
/// **메모리에 못 둔다.** 배포가 Cloudflare Workers 라 isolate 마다 카운터가 갈리고,
/// Vercel 로 가도 함수 인스턴스마다 메모리가 따로다. 배포지를 바꿔서 우회되는 문제가 아니다.
///
/// **코드 행에 카운터를 붙이지 않는다.** 자동 대입은 존재하지 않는 코드를 주로 때려서
/// 셀 행이 없다 — 세는 단위가 IP 여야 방어가 된다.
///
/// 오래된 행을 지우는 크론을 두지 않는다. 판정이 15분 창만 보므로 무해하고,
/// 교환에 성공하면 그 IP 의 행을 지운다 — 정상 사용에서는 이 테이블이 비어 있다.
model InviteAttempt {
  id String   @id @default(cuid())
  /// cf-connecting-ip 또는 x-forwarded-for 의 첫 항. 못 얻으면 "unknown"
  ip String
  at DateTime @default(now())

  /// 판정이 항상 「이 ip 의 최근 15분」이라 두 컬럼을 한 인덱스로 받는다
  @@index([ip, at])
}

// ─────────────────────────────────────────── 향 계층 (4-6 · 4-7)

model FlavorNode {
  /// slug 를 그대로 pk 로 쓴다. 집계 축이라 안정적인 식별자가 필요하다
  id       String  @id
  level    Int
  parentId String?
  labelKo  String
  labelEn  String
  /// "#rrggbb". 비면 부모에서 상속한다 — 정책을 스키마에 굳히지 않는다.
  /// 「L1 · L2 에만 준다」도 특정 노드에만 따로 주는 것도 스키마 변경 없이 된다
  /// (설계 2026-09-08 §6). SCA 휠 색을 그대로 옮기지 않는다 — CC BY-NC-ND 라서
  /// 110개 값을 통째로 복사하면 그 선택의 집합이 된다. 값은 globals.css 토큰에서 고른다
  color    String?

  parent   FlavorNode?  @relation("NodeTree", fields: [parentId], references: [id])
  children FlavorNode[] @relation("NodeTree")

  aliases       NoteAlias[]
  sellerNotes   SellerNote[]
  extraNotes    ExtraNote[]
  noteProposals SellerNoteProposal[]

  @@index([level])
  @@index([parentId])
}

enum AliasScope {
  PERSONAL
  PUBLIC
}

model NoteAlias {
  id String @id @default(cuid())
  /// 표시용 원문
  raw String
  /// 정규화 값. unique 대상이라 별도 컬럼에 저장한다 (8장 「Prisma 로 안 되는 것」)
  normalizedRaw String
  /// 같은 향의 다른 표기(`베르가못` 의 `Bergamot`). 병합으로만 채워진다 (mergeAlias).
  /// 배열이 아니라 칸 하나다 — 배열로 가면 자동완성의 부분 일치(`berga`)가 죽는다
  rawEn         String?
  normalizedEn  String?
  nodeId        String
  /// 이 표현만의 색. null 이면 앉은 축에서 물려받는다 (설계 2026-09-08 §6).
  /// **기본은 상속이다** — 표현마다 색을 정하는 것이 아니라, 축 색이 안 맞는 것만 덮는다
  color         String?
  scope         AliasScope @default(PERSONAL)
  createdById   String?
  /// 서로 다른 유저 수. 승격 판단용 (5장)
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())

  node      FlavorNode @relation(fields: [nodeId], references: [id])
  createdBy User?      @relation(fields: [createdById], references: [id])

  /// 개인 별칭은 사람당 표현당 하나.
  /// **public 에는 이 제약이 동작하지 않는다** — createdById 가 NULL 이고 Postgres 에서
  /// NULL 끼리는 충돌하지 않기 때문이다. public 유일성은 부분 유니크 인덱스로 따로 건다
  /// (migrations/..._note_alias_public_unique).
  @@unique([normalizedRaw, scope, createdById])
  @@index([nodeId])
  /// 노트 입력의 자동완성이 타이핑마다 이 컬럼을 `contains` 로 훑는다.
  /// 별칭은 표현이 쌓이는 만큼 무한히 는다 — 여기가 셋 중 제일 커진다
  @@index([normalizedRaw(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([normalizedEn(ops: raw("gin_trgm_ops"))], type: Gin)
}

// ─────────────────────────────────────────── lookup (4-8)

enum LookupKind {
  COUNTRY
  VARIETY
  PROCESS
}

enum LookupStatus {
  PENDING
  APPROVED
}

/// country · variety · process 를 한 테이블로. 형태가 같고 화면도 같다.
/// country 만 닫힌 집합이라 인라인 추가를 코드에서 막는다 (4-8)
model LookupValue {
  id   String     @id @default(cuid())
  kind LookupKind
  /// ISO 코드 등. country 외에는 null
  code           String?
  nameKo         String
  nameEn         String?
  normalizedName String
  /// 목록 정렬 가중치. 큰 것이 먼저 온다.
  /// country 249개를 가나다순으로 깔면 가나 · 가봉부터 나와 커피 산지가 안 보인다.
  /// variety · process 도 자주 쓰는 것을 위로 올릴 자리다. 어드민이 조정한다
  sortWeight     Int          @default(0)
  /// 표기 흔들림 흡수. 어드민 병합의 실체가 행 삭제가 아니라 흡수여야 한다 (4-8)
  /// 게이샤/게샤 · 무산소/애너로빅 · 공발효/코퍼멘테이션 · 펄프드내추럴→허니
  aliases        String[]     @default([])
  status         LookupStatus @default(PENDING)
  createdById    String?
  createdAt      DateTime     @default(now())

  createdBy User? @relation(fields: [createdById], references: [id])

  @@unique([kind, normalizedName])
  @@index([kind, status])
  @@index([kind, sortWeight])
}

// ─────────────────────────────────────────── Vendor (4-2)

enum VendorRole {
  ROASTER
  IMPORTER
  CAFE
}

enum VendorStatus {
  PENDING
  APPROVED
}

model Vendor {
  id   String @id @default(cuid())
  name String
  /// unique 대상 (8장)
  normalizedName String @unique
  /// 표기 흔들림 흡수 (4-2)
  aliases     String[]     @default([])
  roles       VendorRole[] @default([])
  website     String?
  region      String?
  status      VendorStatus @default(PENDING)
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  createdBy User?     @relation(fields: [createdById], references: [id])
  products  Product[]

  @@index([status])
  /// 근접 검색용 GIN 트라이그램 (설계 8장).
  /// **raw SQL 마이그레이션으로 만들면 다음 `migrate dev` 가 지운다** —
  /// schema.prisma 에 없는 인덱스를 Prisma 가 드리프트로 보고 DROP 을 넣는다.
  /// 실제로 20260830105447 이 만든 것을 20260830124500 이 전부 지웠다.
  /// 스키마 안에 두는 것이 유일한 방어다
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin)
}

// ─────────────────────────────────────────── Product (4-3)

enum Category {
  COFFEE
  PERFUME
  WINE
  WHISKY
  DIFFUSER
}

model Product {
  id       String   @id @default(cuid())
  vendorId String
  category Category @default(COFFEE)
  name     String
  /// name 을 표기 사전으로 정규화한 값. unique 대상이라 별도 컬럼 (8장)
  normalizedName String
  /// sellerNotes 의 nodeId 집합 해시. 파생 · 저장 · 재계산 가능 (4-3)
  /// 매핑 실패 항목은 unmapped:{정규화한 raw} 토큰으로 집합에 참여한다
  noteSetHash String
  /// 카테고리별 특화 필드. 스키마는 코드에 정의 (4-3)
  /// coffee: kind · varietyIds[] · processId · infused · roastLevel · agtron
  ///         countryId · region · farm · producer · lot · countryIds[]
  /// 주의: 안의 lookup id 에 FK 를 걸 수 없다. 무결성은 애플리케이션이 진다
  attributes  Json     @default("{}")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor      Vendor       @relation(fields: [vendorId], references: [id])
  createdBy   User?        @relation(fields: [createdById], references: [id])
  sellerNotes SellerNote[]
  experiences Experience[]
  noteProposals SellerNoteProposal[]

  /// 동일성 키 (4-3)
  @@unique([vendorId, category, normalizedName, noteSetHash])
  @@index([vendorId])
  /// 원두명 근접 검색. `contains` 는 LIKE '%q%' 라 B-tree 로는 못 좁힌다
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// 사용자가 낸 판매자 노트 추가 제안.
///
/// **SellerNote 로 바로 안 들어간다.** 노트는 Product 동일성 키의 절반이라
/// (`noteSetHash`) 사람마다 다르게 보일 수 없다 — `pending` Vendor 처럼 "등록자에게는
/// 즉시 보인다" 를 못 한다. 승격되는 순간에만 SellerNote 가 되고, 그 전까지는
/// 어느 화면에도 노트로 안 나온다.
///
/// 승격은 어드민이 한다. 자동 승격(동의 N명)은 사람이 붙어 실제 분포를 본 뒤에 정한다 —
/// 지금 임계값을 정하면 근거 없는 숫자다 (설계 9장이 별칭 승격 큐를 미뤄둔 것과 같은 기준).
model SellerNoteProposal {
  id        String @id @default(cuid())
  productId String
  /// 표시용 원문
  raw String
  /// 동의를 묶는 키. 표기가 흔들리면("자스민" · "쟈스민") 같은 제안으로 안 세어져
  /// 동의가 영영 안 모인다
  normalizedRaw String
  /// 자동완성이 붙인 축. 없으면 어드민이 붙인다
  nodeId      String?
  createdById String
  createdAt   DateTime @default(now())

  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  node      FlavorNode? @relation(fields: [nodeId], references: [id])
  createdBy User        @relation(fields: [createdById], references: [id])

  /// 한 사람은 같은 원두에 같은 표현을 한 번만 낸다. **그 행 하나가 곧 동의 1이다** —
  /// 별도의 동의 테이블을 두지 않는다
  @@unique([productId, normalizedRaw, createdById])
  @@index([productId])
}

/// 판매자 노트. 항목 단위 행으로 저장한다 — 배열/JSON 이면 noteHits 가 참조할 수 없다
model SellerNote {
  id        String @id @default(cuid())
  productId String
  /// 원문. 매핑에 실패해도 폐기하지 않는다 (5장)
  raw String
  /// 매핑 실패 시 null. noteSetHash 는 unmapped 토큰으로 받는다
  nodeId String?
  /// 화면 표시 순서
  position Int
  /// 이 노트가 Product 에 추가된 시각. 기록 이후 추가분 판정에 쓴다 (7-4)
  addedAt DateTime @default(now())

  product  Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  node     FlavorNode? @relation(fields: [nodeId], references: [id])
  noteHits NoteHit[]

  @@unique([productId, position])
  @@index([nodeId])
}

// ─────────────────────────────────────────── Experience (4-4 · 4-5)

enum BrewMethod {
  HAND_DRIP
  ESPRESSO
  COLD_BREW
}

enum Phase {
  /// v1 값. 단계를 나누지 않은 통합 인상
  OVERALL
  NOSE
  PALATE
  FINISH
  TOP
  MIDDLE
  BASE
}

model Experience {
  id String @id @default(cuid())
  /// 동일성 키에 반드시 포함. 혼자 써도 넣는다 (9장 「나중에 못 고치는 것」)
  userId    String
  productId String
  method    BrewMethod @default(HAND_DRIP)
  phase     Phase      @default(OVERALL)
  place     String?
  /// coffee: myRoastLevel 등
  attributes Json @default("{}")
  /// v0.1 은 입력 UI 없음
  memo String?
  /// 처음 경험한 날
  createdAt DateTime @default(now())
  /// 마지막으로 경험한 날 (drankAt 을 따로 두지 않는 이유 · 4-4)
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id])
  noteHits   NoteHit[]
  extraNotes ExtraNote[]

  /// 동일성 키 (4-4)
  @@unique([userId, productId, method, phase])
  @@index([productId])
}

enum NoteHitValue {
  /// 안 났다. 초기값. 안 건드린 것이 곧 이 값이다 (4-5)
  MISS
  /// 이게 그 맛인지 모르겠다. 적중률 분모에서 제외 · 경계율 지표
  UNSURE
  /// 느꼈다 (강도 1)
  WEAK
  /// 느꼈다 (강도 2)
  STRONG
}

/// 노트 항목 단위 행. JSON blob 금지 — 소급 부분 보존이 원리적으로 불가능해진다 (4-4)
model NoteHit {
  id           String       @id @default(cuid())
  experienceId String
  sellerNoteId String
  value        NoteHitValue @default(MISS)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  sellerNote SellerNote @relation(fields: [sellerNoteId], references: [id], onDelete: Cascade)

  @@unique([experienceId, sellerNoteId])
}

/// 내가 추가로 느낀 노트. v0.1 은 입력 UI 없음 — 엔진(3차)이 쓰는 값이다
model ExtraNote {
  id           String   @id @default(cuid())
  experienceId String
  raw          String
  nodeId       String?
  createdAt    DateTime @default(now())

  experience Experience  @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  node       FlavorNode? @relation(fields: [nodeId], references: [id])

  @@index([experienceId])
}
